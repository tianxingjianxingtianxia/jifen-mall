/* order-detail + shared */
.order-status-badge { text-align:center; font-size:36rpx; font-weight:700; padding:16rpx 0; }
.status-0 { color: var(--warning); }
.status-1 { color: #409eff; }
.status-2 { color: var(--success); }
.status-3 { color: var(--info); }
.order-img { width:120rpx; height:120rpx; border-radius:12rpx; background:var(--bg); }
.info-row { display:flex; justify-content:space-between; padding:16rpx 0; border-bottom:1rpx solid var(--border); font-size:28rpx; }
.section-title { font-size:28rpx; font-weight:600; margin-bottom:8rpx; display:block; }
.bottom-bar { display:flex; gap:24rpx; padding:24rpx; }
.bottom-bar .btn-outline { flex:1; text-align:center; padding:20rpx 0; }
.bottom-bar .btn-primary { flex:1; height:72rpx; line-height:72rpx; }
