<!-- pages/profile/profile.wxml -->
<view>
  <view class="jd-profile-top">
    <view class="jd-avatar-row">
      <view class="jd-avatar">👤</view>
      <view class="jd-user-info">
        <view class="jd-user-name">{{userInfo ? userInfo.nickname || userInfo.username : '未登录'}}</view>
        <view class="jd-user-points">{{points}} 积分</view>
      </view>
    </view>
  </view>

  <view class="jd-menu-list">
    <view class="jd-menu-item" bindtap="goAddresses">
      <text>📍 收货地址管理</text>
      <text class="jd-menu-arrow">›</text>
    </view>
    <view class="jd-menu-item" bindtap="goPointsRecords">
      <text>📋 积分明细</text>
      <text class="jd-menu-arrow">›</text>
    </view>
  </view>

  <view style="padding:40rpx 24rpx;">
    <button style="width:100%;height:80rpx;line-height:80rpx;border-radius:40rpx;font-size:28rpx;border:2rpx solid #ddd;color:#999;background:#fff;" bindtap="logout">退出登录</button>
  </view>
</view>
