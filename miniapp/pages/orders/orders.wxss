/* pages/orders/orders.wxss */
.tab-bar {
  display: flex;
  white-space: nowrap;
  background: var(--white);
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid var(--border);
}
.tab-item {
  display: inline-block;
  padding: 12rpx 32rpx;
  font-size: 28rpx;
  color: var(--text-light);
  border-radius: 32rpx;
  margin-right: 16rpx;
  background: var(--bg);
}
.tab-item.active {
  background: var(--primary);
  color: var(--white);
}

.order-card { margin-top: 0; }
.order-status { font-weight: 500; }
.status-0 { color: var(--warning); }
.status-1 { color: #409eff; }
.status-2 { color: var(--success); }
.status-3 { color: var(--info); }

.order-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: var(--bg);
}
.order-footer { gap: 16rpx; }
