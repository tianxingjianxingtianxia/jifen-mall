/* pages/index/index.wxss */

/* 积分卡片 */
.points-card {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
  color: var(--white);
  padding: 32rpx;
}
.points-value {
  font-size: 64rpx;
  font-weight: 700;
}
.points-label {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 4rpx;
}
.points-extra {
  margin-top: 16rpx;
  opacity: 0.7;
}
.signin-btn {
  background: rgba(255,255,255,0.25);
  color: var(--white);
  border: 2rpx solid var(--white);
  border-radius: 40rpx;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  font-weight: 500;
}
.signin-btn.signed {
  background: rgba(255,255,255,0.1);
  opacity: 0.6;
}

/* 搜索栏 */
.search-bar {
  padding: 16rpx 24rpx;
  margin-top: 0;
}
.search-input-wrap {
  background: var(--bg);
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
}
.search-input {
  height: 56rpx;
  font-size: 26rpx;
}
.search-icon {
  font-size: 32rpx;
  padding-left: 16rpx;
}

/* 排序 */
.sort-row {
  margin-top: 20rpx;
  gap: 32rpx;
}
.sort-item {
  font-size: 26rpx;
  color: var(--text-light);
  padding: 8rpx 0;
}
.sort-item.active {
  color: var(--primary);
  font-weight: 600;
  border-bottom: 4rpx solid var(--primary);
}

/* 商品网格 */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 24rpx;
}
.product-item {
  width: calc(50% - 12rpx);
  margin: 0 6rpx 16rpx;
  background: var(--white);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: var(--shadow);
}
.product-img {
  width: 100%;
  height: 340rpx;
  background: var(--bg);
}
.product-info {
  padding: 16rpx;
}
.product-name {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
  display: block;
}
.product-points {
  font-size: 30rpx;
  font-weight: 700;
}
