<!-- pages/addresses/addresses.wxml -->
<view>
  <view wx:if="{{addresses.length > 0}}">
    <view class="jd-addr-card" wx:for="{{addresses}}" wx:key="id">
      <view class="jd-addr-tag" wx:if="{{item.isDefault === 1}}">默认</view>
      <view style="display:flex;justify-content:space-between;">
        <text style="font-weight:600;font-size:30rpx;">{{item.receiverName}}</text>
        <text style="font-size:28rpx;">{{item.receiverPhone}}</text>
      </view>
      <view style="font-size:26rpx;color:#999;margin-top:16rpx;">{{item.province}}{{item.city}}{{item.district}} {{item.detailAddress}}</view>
      <view style="display:flex;justify-content:flex-end;gap:32rpx;margin-top:20rpx;padding-top:20rpx;border-top:1rpx solid #f5f5f5;">
        <text wx:if="{{item.isDefault !== 1}}" style="font-size:24rpx;color:#e4393c;" bindtap="setDefault" data-id="{{item.id}}">设为默认</text>
        <text style="font-size:24rpx;color:#999;" bindtap="goEdit" data-id="{{item.id}}">编辑</text>
        <text style="font-size:24rpx;color:#e4393c;" bindtap="deleteAddress" data-id="{{item.id}}">删除</text>
      </view>
    </view>
  </view>
  <view class="jd-empty" wx:else>
    <view class="jd-empty-icon">📍</view><view>暂无地址</view>
  </view>

  <view class="jd-bottom-btn">
    <button bindtap="goAdd">新增地址</button>
  </view>
</view>
