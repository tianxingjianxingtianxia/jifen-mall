/* pages/login/login.wxss */
.login-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 0 60rpx;
  background: var(--white);
}

.login-logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
}
.logo-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}
.logo-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 12rpx;
}
.logo-desc {
  font-size: 28rpx;
  color: var(--text-light);
}

.login-btn-wrap {
  width: 100%;
  max-width: 500rpx;
}
.login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--primary);
  color: var(--white);
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  text-align: center;
}
.login-btn[disabled] {
  background: #ccc;
  color: #999;
}
.login-tip {
  display: block;
  text-align: center;
  color: var(--text-lighter);
  font-size: 24rpx;
  margin-top: 24rpx;
}

/* 开发测试登录 */
.dev-section {
  width: 100%;
  max-width: 500rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  background: var(--bg);
  border-radius: 16rpx;
}
.dev-tabs {
  margin-bottom: 24rpx;
  gap: 32rpx;
  justify-content: center;
}
.dev-tab {
  font-size: 28rpx;
  color: var(--text-light);
  padding-bottom: 8rpx;
}
.dev-tab.active {
  color: var(--primary);
  font-weight: 600;
  border-bottom: 4rpx solid var(--primary);
}
.dev-form .form-input {
  width: 100%;
  height: 72rpx;
  background: var(--white);
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}
.dev-btn {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  background: #409eff;
  color: var(--white);
  border-radius: 8rpx;
  font-size: 28rpx;
  border: none;
  margin-top: 8rpx;
}
