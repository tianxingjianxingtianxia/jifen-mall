<!-- 顶部导航栏 -->
<view class="nav-bar" style="background: {{backgroundColor}}; padding-top: {{statusBarHeight}}px;">
  <view class="nav-inner" style="height: {{navBarHeight}}px;">
    <view class="nav-left" bindtap="onBack" wx:if="{{showBack}}">
      <image class="nav-back-icon" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='white'%3E%3Cpath d='M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z'/%3E%3C/svg%3E"></image>
    </view>
    <view class="nav-title">{{title}}</view>
    <view class="nav-right"></view>
  </view>
</view>
