.points-card {
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 20rpx;
  padding: 32rpx 36rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}
.points-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}
.points-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  display: block;
}
.points-value {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-top: 4rpx;
}
.sign-btn {
  min-width: 144rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: rgba(255,255,255,0.2);
  border: 2rpx solid rgba(255,255,255,0.4);
  border-radius: 36rpx;
  font-size: 28rpx;
  color: #fff;
  padding: 0 32rpx;
}
.sign-btn.signed {
  background: rgba(103, 194, 58, 0.3);
  border-color: rgba(103, 194, 58, 0.5);
}
.sign-btn[disabled] {
  opacity: 0.6;
}
.sign-btn::after {
  border: none;
}
.points-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(255,255,255,0.15);
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-value {
  font-size: 32rpx;
  font-weight: 600;
  display: block;
}
.stat-value.earn { color: #67c23a; }
.stat-value.spend { color: #f56c6c; }
.stat-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 4rpx;
  display: block;
}
.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: rgba(255,255,255,0.15);
}
