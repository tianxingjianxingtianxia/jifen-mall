.order-card {
  padding: 24rpx;
}
.order-header {
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f5f7fa;
}
.order-no {
  font-size: 24rpx;
  color: #909399;
}
.order-status {
  font-size: 26rpx;
  font-weight: 500;
}
.status-warning { color: #e6a23c; }
.status-primary { color: #409eff; }
.status-success { color: #67c23a; }
.status-info { color: #909399; }
.order-body {
  display: flex;
  gap: 24rpx;
  margin-bottom: 20rpx;
}
.order-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f5f7fa;
  flex-shrink: 0;
}
.order-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.order-product-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #303133;
  display: block;
}
.order-points {
  font-size: 26rpx;
  color: #606266;
  display: block;
}
.points-num {
  color: #e6a23c;
  font-weight: 600;
}
.order-time {
  font-size: 22rpx;
  color: #c0c4cc;
  display: block;
}
.order-footer {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f5f7fa;
}
.action-btn {
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  border: 2rpx solid #dcdfe6;
  background: #fff;
  color: #606266;
}
.action-btn::after { border: none; }
.action-btn.cancel { color: #f56c6c; border-color: #f56c6c; }
.action-btn.confirm { color: #67c23a; border-color: #67c23a; }
.action-btn.default { color: #409eff; border-color: #409eff; }
