.page { background: #f5f7fa; min-height: 100vh; }

/* 用户信息头部 */
.profile-header {
  background: linear-gradient(135deg, #667eea, #764ba2);
  padding: 100rpx 32rpx 48rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.avatar-wrap {
  width: 100rpx; height: 100rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  border: 4rpx solid rgba(255,255,255,0.3);
  display: flex; align-items: center; justify-content: center;
}
.avatar-text { font-size: 40rpx; font-weight: 700; color: #fff; }
.profile-info { flex: 1; }
.profile-name { font-size: 34rpx; font-weight: 700; color: #fff; display: block; }
.profile-id { font-size: 22rpx; color: rgba(255,255,255,0.6); margin-top: 4rpx; display: block; }
.profile-points {
  background: rgba(255,255,255,0.15);
  border-radius: 20rpx;
  padding: 12rpx 24rpx;
  text-align: center;
}
.profile-points-num { font-size: 40rpx; font-weight: 800; color: #fff; display: block; }
.profile-points-lbl { font-size: 22rpx; color: rgba(255,255,255,0.7); }

/* 菜单 */
.menu-section {
  background: #fff;
  border-radius: 24rpx;
  margin: -20rpx 24rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
}
.menu-item:active { opacity: 0.7; }
.menu-icon { font-size: 36rpx; margin-right: 20rpx; width: 40rpx; text-align: center; }
.menu-label { flex: 1; font-size: 28rpx; color: #303133; }
.menu-arrow { font-size: 36rpx; color: #c0c4cc; }
.menu-divider { height: 2rpx; background: #f5f7fa; margin: 0 30rpx; }

/* 退出 */
.logout-section { margin: 40rpx 24rpx; }
.logout-btn {
  width: 100%; height: 88rpx; line-height: 88rpx;
  background: #fff; color: #f56c6c;
  border-radius: 44rpx;
  font-size: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  border: 2rpx solid #fee2e2;
}
.logout-btn::after { border: none; }
