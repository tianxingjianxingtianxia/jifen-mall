.page-container {
  padding: 0 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 用户头部 */
.user-header {
  display: flex;
  align-items: center;
  gap: 30rpx;
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
  margin: 0 -30rpx;
  color: #fff;
}

.user-avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255,255,255,0.5);
  flex-shrink: 0;
}

.user-avatar {
  width: 100%;
  height: 100%;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
}

.user-points {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 积分统计 */
.points-stats {
  display: flex;
  align-items: center;
  padding: 30rpx 20rpx;
  margin-top: 30rpx;
  margin-bottom: 20rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.stat-divider {
  width: 2rpx;
  height: 50rpx;
  background: var(--border-color);
}

/* 菜单列表 */
.menu-list {
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--text-secondary);
}

.menu-divider {
  height: 2rpx;
  background: var(--border-color);
}

/* 退出登录 */
.logout-section {
  padding: 40rpx 0;
}

.logout-btn {
  width: 100%;
  height: 84rpx;
  border-radius: var(--radius-md);
  background: #fff;
  color: var(--danger);
  font-size: 30rpx;
  font-weight: 500;
  border: 2rpx solid var(--danger);
  display: flex;
  align-items: center;
  justify-content: center;
}

.logout-btn:active {
  background: rgba(245, 108, 108, 0.05);
}
