<view class="page">
  <!-- 用户信息头部 -->
  <view class="profile-header">
    <view class="avatar-wrap">
      <text class="avatar-text">{{avatarFirst}}</text>
    </view>
    <view class="profile-info">
      <text class="profile-name">{{nickname || '用户'}}</text>
      <text class="profile-id">ID: {{userId}}</text>
    </view>
    <view class="profile-points" bindtap="onGoRecords">
      <text class="profile-points-num">{{points}}</text>
      <text class="profile-points-lbl">积分 ›</text>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="onGoRecords">
      <text class="menu-icon menu-icon-records">📊</text>
      <text class="menu-label">积分明细</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-item" bindtap="onGoAddresses">
      <text class="menu-icon menu-icon-address">📍</text>
      <text class="menu-label">地址管理</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <button class="logout-btn" bindtap="onLogout">退出登录</button>
  </view>
</view>
