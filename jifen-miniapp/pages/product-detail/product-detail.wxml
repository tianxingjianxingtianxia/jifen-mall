<nav-bar title="商品详情" />

<scroll-view class="page-container" scroll-y enhanced show-scrollbar="{{false}}"
  style="padding-top: calc(88rpx + env(safe-area-inset-top));">

  <view wx:if="{{loading}}" class="loading-container">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{product}}">
    <!-- 商品展示区 -->
    <image class="product-img" src="{{product.coverImage}}" mode="widthFix" />
    <view wx:if="{{product.images && product.images.length > 0}}" class="product-thumbs">
      <image wx:for="{{product.images}}" wx:key="*this" class="thumb-img" src="{{item}}" mode="aspectFill" />
    </view>

    <view class="info-card card">
      <text class="product-name">{{product.name}}</text>
      <text class="product-points">{{product.pointsRequired}} 积分</text>
      <text class="product-stock" wx:if="{{product.stock != null}}">库存：{{product.stock}} | 已售：{{product.saleCount || 0}}</text>
      <text class="product-desc" wx:if="{{product.description}}">{{product.description}}</text>
    </view>

    <!-- 收货地址选择 -->
    <view class="address-section card">
      <view class="section-title">选择收货地址</view>
      <view class="address-item" wx:for="{{addresses}}" wx:key="id"
        data-id="{{item.id}}" bindtap="onSelectAddress">
        <radio checked="{{selectedAddressId === item.id}}" color="#667eea" />
        <view class="address-info">
          <text class="address-name">{{item.receiverName}} {{item.receiverPhone}}</text>
          <text class="address-detail">{{item.province}}{{item.city}}{{item.district}}{{item.detailAddress}}</text>
        </view>
        <text class="default-tag" wx:if="{{item.isDefault}}">默认</text>
      </view>
      <view class="add-address" bindtap="onAddAddress">+ 新增地址</view>
    </view>

    <!-- 底部操作栏 -->
    <view class="bottom-bar">
      <text class="points-balance">可用积分：{{points}}</text>
      <button class="btn-primary" bindtap="onExchange"
        disabled="{{!selectedAddressId || points < product.points}}">
        立即兑换
      </button>
    </view>
  </view>

  <empty-state wx:elif="{{!loading}}" text="商品不存在" />
</scroll-view>
