.page-container {
  padding: 0 0 160rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 轮播图 */
.detail-swiper {
  width: 100%;
  height: 750rpx;
}
.swiper-img {
  width: 100%;
  height: 100%;
}

/* 商品信息 */
.detail-info {
  padding: 30rpx;
  margin: 20rpx 30rpx;
}
.detail-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  display: block;
}
.detail-points-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 12rpx;
}
.detail-points {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--danger);
}
.detail-price {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-decoration: line-through;
}
.detail-meta {
  display: flex;
  gap: 40rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 描述 */
.detail-desc {
  padding: 30rpx;
  margin: 0 30rpx 20rpx;
}
.desc-content {
  font-size: 28rpx;
  color: var(--text-regular);
  line-height: 1.6;
}

/* 收货地址 */
.address-section {
  padding: 30rpx;
  margin: 0 30rpx 20rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}
.address-name-phone {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.address-name {
  font-size: 28rpx;
  font-weight: 500;
}
.address-phone {
  font-size: 26rpx;
  color: var(--text-regular);
}
.default-tag {
  font-size: 22rpx;
  color: var(--primary-start);
  background: rgba(102, 126, 234, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}
.address-detail {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
}
.address-empty {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--text-secondary);
  font-size: 28rpx;
}
.arrow {
  font-size: 32rpx;
  color: var(--text-secondary);
}

/* 底部兑换按钮 */
.exchange-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card-bg);
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
}
.exchange-btn {
  width: 100%;
}
