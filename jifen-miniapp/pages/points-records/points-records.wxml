<nav-bar title="积分明细" />

<scroll-view class="page-container" scroll-y enhanced show-scrollbar="{{false}}"
  bindscrolltolower="onReachBottom"
  style="padding-top: calc(88rpx + env(safe-area-inset-top));">

  <!-- 积分统计头部 -->
  <view class="records-header card">
    <view class="stat-item">
      <text class="stat-value">-</text>
      <text class="stat-label">本月获得</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">-</text>
      <text class="stat-label">本月消耗</text>
    </view>
  </view>

  <!-- 积分列表 -->
  <view class="records-list" wx:if="{{records.length > 0}}">
    <view class="record-item" wx:for="{{records}}" wx:key="id">
      <view class="record-left">
        <view class="record-source">
          <text class="source-dot type-{{item.type}}"></text>
          <text class="source-text">{{item.sourceText}}</text>
        </view>
        <text class="record-time">{{item.timeFormatted}}</text>
      </view>
      <view class="record-right">
        <text class="record-points {{item.type === 1 ? 'earn' : 'spend'}}">
          {{item.type === 1 ? '+' : '-'}}{{item.points}}
        </text>
        <text class="record-type {{item.type === 1 ? 'tag-earn' : 'tag-spend'}}">{{item.typeText}}</text>
      </view>
    </view>
  </view>

  <empty-state wx:elif="{{!loading}}" text="暂无积分记录" />

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{loading}}">
    <text class="load-more-text">加载中...</text>
  </view>
  <view class="load-more" wx:elif="{{!hasMore && records.length > 0}}">
    <text class="load-more-text">— 没有更多了 —</text>
  </view>
</scroll-view>
