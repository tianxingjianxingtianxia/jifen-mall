<nav-bar title="积分明细" />

<view class="page">

  <view class="record-list" wx:if="{{records.length > 0}}">
    <view class="record-item" wx:for="{{records}}" wx:key="id">
      <view class="record-left">
        <view class="record-dot type-{{item.type}}"></view>
        <view class="record-info">
          <text class="record-source">{{item.sourceText}}</text>
          <text class="record-time">{{item.timeFormatted}}</text>
        </view>
      </view>
      <text class="record-points type-{{item.type}}">{{item.type === 1 ? '+' : '-'}}{{item.points}}</text>
    </view>
    <view class="record-divider"></view>
  </view>

  <empty-state wx:elif="{{!loading}}" text="暂无积分记录" />

  <view class="load-more" wx:if="{{loading}}"><text>加载中...</text></view>
  <view class="load-more" wx:elif="{{!hasMore && records.length > 0}}"><text>— 没有更多了 —</text></view>
  <view style="height:40rpx;"></view>
</view>
