.page { background: #f5f7fa; min-height: 100vh; }
.page-header {
  background: linear-gradient(135deg, #667eea, #764ba2);
  padding: 120rpx 32rpx 60rpx;
}
.page-title { font-size: 36rpx; font-weight: 700; color: #fff; }

.record-list { padding: 0 24rpx; margin-top: -20rpx; }
.record-item {
  display: flex; align-items: center; justify-content: space-between;
  background: #fff; padding: 28rpx 30rpx;
  border-radius: 16rpx; margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.record-left { display: flex; align-items: center; gap: 16rpx; flex: 1; }
.record-dot {
  width: 16rpx; height: 16rpx; border-radius: 50%;
  flex-shrink: 0;
}
.record-dot.type-1 { background: #48bb78; }
.record-dot.type-2 { background: #fc8181; }
.record-info { }
.record-source { font-size: 28rpx; color: #303133; display: block; }
.record-time { font-size: 22rpx; color: #c0c4cc; margin-top: 4rpx; display: block; }
.record-points { font-size: 30rpx; font-weight: 700; flex-shrink: 0; }
.record-points.type-1 { color: #48bb78; }
.record-points.type-2 { color: #fc8181; }

.load-more { text-align: center; padding: 20rpx; font-size: 24rpx; color: #c0c4cc; }
