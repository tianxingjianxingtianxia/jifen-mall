.page-container {
  padding: 20rpx 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 统计头部 */
.records-header {
  display: flex;
  align-items: center;
  padding: 30rpx 40rpx;
  margin-bottom: 20rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: var(--border-color);
}

/* 记录列表 */
.records-list {
  margin-top: 0;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx;
  background: var(--card-bg);
  border-radius: var(--radius-md);
  margin-bottom: 16rpx;
  box-shadow: var(--shadow);
}

.record-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.record-source {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.source-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.source-dot.type-1 {
  background: var(--success);
}

.source-dot.type-2 {
  background: var(--danger);
}

.source-text {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.record-time {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.record-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.record-points {
  font-size: 32rpx;
  font-weight: 600;
}

.record-points.earn {
  color: var(--success);
}

.record-points.spend {
  color: var(--danger);
}

.record-type {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.tag-earn {
  color: var(--success);
  background: rgba(103, 194, 58, 0.1);
}

.tag-spend {
  color: var(--danger);
  background: rgba(245, 108, 108, 0.1);
}

/* 加载更多 */
.load-more {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}

.load-more-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}
