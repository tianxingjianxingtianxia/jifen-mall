.page-container {
  padding: 0 30rpx 160rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 状态头部 */
.status-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx;
  margin: 0 -30rpx 20rpx;
  color: #fff;
}
.status-bg-0 { background: linear-gradient(135deg, #667eea, #764ba2); }
.status-bg-1 { background: linear-gradient(135deg, #f093fb, #f5576c); }
.status-bg-2 { background: linear-gradient(135deg, #4facfe, #00f2fe); }
.status-bg-3 { background: linear-gradient(135deg, #a8a8a8, #d0d0d0); }
.status-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.status-text { font-size: 40rpx; font-weight: 600; margin-bottom: 8rpx; }
.status-hint { font-size: 26rpx; opacity: 0.85; }

/* 信息卡片 */
.info-card, .product-card-info, .address-card, .timeline {
  padding: 30rpx;
  margin-bottom: 20rpx;
}
.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  font-size: 28rpx;
}
.info-label {
  color: var(--text-secondary);
}
.info-value {
  color: var(--text-primary);
}
.info-value.status-color-0 { color: var(--warning); }
.info-value.status-color-1 { color: var(--primary-start); }
.info-value.status-color-2 { color: var(--success); }
.info-value.status-color-3 { color: var(--info); }

/* 商品信息 */
.product-card-info {
  display: flex;
  gap: 24rpx;
  align-items: center;
}
.product-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}
.product-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.product-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}
.product-points {
  font-size: 28rpx;
  color: var(--danger);
  font-weight: 500;
}

/* 收货信息 */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}
.address-row {
  display: flex;
  padding: 10rpx 0;
  font-size: 28rpx;
}
.address-label {
  width: 140rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}
.address-value {
  flex: 1;
  color: var(--text-primary);
}

/* 时间线 */
.timeline-item {
  display: flex;
  gap: 20rpx;
  padding-bottom: 24rpx;
  position: relative;
}
.timeline-item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 32rpx;
  bottom: 0;
  width: 2rpx;
  background: var(--border-color);
}
.timeline-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--border-color);
  flex-shrink: 0;
  margin-top: 6rpx;
}
.timeline-dot.active {
  background: var(--primary-start);
}
.timeline-content {
  flex: 1;
  display: flex;
  justify-content: space-between;
}
.timeline-text {
  font-size: 28rpx;
  color: var(--text-regular);
}
.timeline-time {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 操作按钮 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card-bg);
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
}
.action-btn {
  flex: 1;
  height: 80rpx;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}
.action-btn.cancel {
  background: #fff;
  color: var(--danger);
  border: 2rpx solid var(--danger);
}
.action-btn.confirm {
  background: linear-gradient(135deg, var(--primary-start), var(--primary-end));
  color: #fff;
  border: none;
}
