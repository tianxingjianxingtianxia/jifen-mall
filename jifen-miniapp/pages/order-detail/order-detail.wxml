<nav-bar title="订单详情" />

<scroll-view class="page-container" scroll-y enhanced show-scrollbar="{{false}}"
  style="padding-top: calc(88rpx + env(safe-area-inset-top));">

  <view wx:if="{{loading}}" class="loading-container">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{order}}">
    <!-- 状态标题区 -->
    <view class="status-header status-bg-{{order.status}}">
      <text class="status-icon" wx:if="{{order.status === 0}}">📦</text>
      <text class="status-icon" wx:elif="{{order.status === 1}}">🚚</text>
      <text class="status-icon" wx:elif="{{order.status === 2}}">✅</text>
      <text class="status-icon" wx:elif="{{order.status === 3}}">❌</text>
      <text class="status-text">{{statusText}}</text>
      <text class="status-hint" wx:if="{{order.status === 0}}">等待卖家发货</text>
      <text class="status-hint" wx:elif="{{order.status === 1}}">商品正在运送途中</text>
      <text class="status-hint" wx:elif="{{order.status === 2}}">交易已完成</text>
      <text class="status-hint" wx:elif="{{order.status === 3}}">订单已取消</text>
    </view>

    <!-- 订单信息 -->
    <view class="info-card card">
      <view class="info-row">
        <text class="info-label">订单编号</text>
        <text class="info-value">{{order.orderNo}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">下单时间</text>
        <text class="info-value">{{createTimeFormatted}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">订单状态</text>
        <text class="info-value status-color-{{order.status}}">{{statusText}}</text>
      </view>
    </view>

    <!-- 商品信息 -->
    <view class="product-card-info card">
      <image class="product-img" src="{{order.productImage || '/assets/images/default.png'}}" mode="aspectFill" />
      <view class="product-detail">
        <text class="product-name">{{order.productName}}</text>
        <text class="product-points">消耗 {{order.pointsSpent}} 积分</text>
      </view>
    </view>

    <!-- 收货信息 -->
    <view class="address-card card" wx:if="{{order.addressName}}">
      <view class="section-title">收货信息</view>
      <view class="address-row">
        <text class="address-label">收货人</text>
        <text class="address-value">{{order.addressName}}</text>
      </view>
      <view class="address-row">
        <text class="address-label">联系电话</text>
        <text class="address-value">{{order.addressPhone}}</text>
      </view>
      <view class="address-row">
        <text class="address-label">收货地址</text>
        <text class="address-value">{{order.addressDetail}}</text>
      </view>
    </view>

    <!-- 订单时间线 -->
    <view class="timeline card" wx:if="{{timeline && timeline.length > 0}}">
      <view class="section-title">订单进度</view>
      <view class="timeline-item" wx:for="{{timeline}}" wx:key="index">
        <view class="timeline-dot {{index === 0 ? 'active' : ''}}"></view>
        <view class="timeline-content">
          <text class="timeline-text">{{item.text}}</text>
          <text class="timeline-time">{{item.timeFormatted}}</text>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-bar" wx:if="{{order.status === 0 || order.status === 1}}">
      <button class="action-btn cancel" wx:if="{{order.status === 0}}" bindtap="onCancel">取消订单</button>
      <button class="action-btn confirm" wx:if="{{order.status === 1}}" bindtap="onConfirm">确认收货</button>
    </view>
  </view>
</scroll-view>
