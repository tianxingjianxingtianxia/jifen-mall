.page-container {
  padding: 0 0 160rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f5f7fa;
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  padding: 0;
}

.form-label {
  font-size: 28rpx;
  color: #303133;
  width: 140rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #303133;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
}
