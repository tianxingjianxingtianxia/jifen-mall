.page-container {
  padding: 0 30rpx 160rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.form-card {
  padding: 0 30rpx;
  margin-top: 20rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  min-height: 100rpx;
  padding: 16rpx 0;
}

.form-item-switch {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.form-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  padding: 8rpx 0;
}

.form-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: var(--text-primary);
  padding: 8rpx 0;
}

.form-picker .placeholder {
  color: var(--text-secondary);
}

.picker-arrow {
  font-size: 32rpx;
  color: var(--text-secondary);
}

.form-switch {
  transform: scale(0.8);
  transform-origin: right center;
}

.form-divider {
  height: 2rpx;
  background: var(--border-color);
}

/* 底部保存 */
.save-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card-bg);
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
}

.save-btn {
  width: 100%;
}
