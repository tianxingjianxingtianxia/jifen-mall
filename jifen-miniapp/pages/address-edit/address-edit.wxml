<scroll-view class="page-container" scroll-y style="padding-top: 20rpx; height: 100vh; box-sizing: border-box;">

  <view class="form-card" style="background:#fff;border-radius:16rpx;margin:20rpx;padding:0 30rpx;box-shadow:0 4rpx 12rpx rgba(0,0,0,0.06);">

    <view class="form-row">
      <text class="form-label">手机号</text>
      <input class="form-input" placeholder="请输入手机号" type="number" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" />
    </view>
    <view style="height:2rpx;background:#f0f0f0;margin:0 -30rpx;"></view>

    <view class="form-row">
      <text class="form-label">收货人</text>
      <input class="form-input" placeholder="请输入收货人姓名" value="{{name}}" bindinput="onNameInput" />
    </view>
    <view style="height:2rpx;background:#f0f0f0;margin:0 -30rpx;"></view>

    <view class="form-row">
      <text class="form-label">省份</text>
      <input class="form-input" placeholder="如：湖南省" value="{{province}}" bindinput="onProvinceInput" />
    </view>
    <view style="height:2rpx;background:#f0f0f0;margin:0 -30rpx;"></view>

    <view class="form-row">
      <text class="form-label">城市</text>
      <input class="form-input" placeholder="如：长沙市" value="{{city}}" bindinput="onCityInput" />
    </view>
    <view style="height:2rpx;background:#f0f0f0;margin:0 -30rpx;"></view>

    <view class="form-row">
      <text class="form-label">区/县</text>
      <input class="form-input" placeholder="如：开福区" value="{{district}}" bindinput="onDistrictInput" />
    </view>
    <view style="height:2rpx;background:#f0f0f0;margin:0 -30rpx;"></view>

    <view class="form-row">
      <text class="form-label">详细地址</text>
      <input class="form-input" placeholder="请输入详细地址" value="{{detailAddress}}" bindinput="onDetailInput" />
    </view>
    <view style="height:2rpx;background:#f0f0f0;margin:0 -30rpx;"></view>

    <view class="form-row" style="justify-content:space-between;">
      <text class="form-label">设为默认</text>
      <switch checked="{{isDefault}}" color="#667eea" bindchange="onDefaultChange" />
    </view>
  </view>

  <view style="padding:40rpx 30rpx;">
    <button class="btn-primary" style="width:100%;height:88rpx;line-height:88rpx;border-radius:44rpx;" bindtap="onSave">保存</button>
  </view>
</scroll-view>
