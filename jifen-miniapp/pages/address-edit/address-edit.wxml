<nav-bar title="{{isEdit ? '编辑地址' : '新增地址'}}" />

<scroll-view class="page-container" scroll-y enhanced show-scrollbar="{{false}}"
  style="padding-top: calc(88rpx + env(safe-area-inset-top));">

  <view class="form-card card">
    <!-- 收货人 -->
    <view class="form-item">
      <text class="form-label">收货人</text>
      <input class="form-input" placeholder="请输入收货人姓名" value="{{name}}" bindinput="onNameInput" />
    </view>
    <view class="form-divider"></view>

    <!-- 手机号 -->
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" placeholder="请输入手机号" type="number" maxlength="11" value="{{phone}}" bindinput="onPhoneInput" />
    </view>
    <view class="form-divider"></view>

    <!-- 省份 -->
    <view class="form-item">
      <text class="form-label">省份</text>
      <input class="form-input" placeholder="如：湖南省" value="{{province}}" bindinput="onProvinceInput" />
    </view>
    <view class="form-divider"></view>

    <!-- 城市 -->
    <view class="form-item">
      <text class="form-label">城市</text>
      <input class="form-input" placeholder="如：长沙市" value="{{city}}" bindinput="onCityInput" />
    </view>
    <view class="form-divider"></view>

    <!-- 区/县 -->
    <view class="form-item">
      <text class="form-label">区/县</text>
      <input class="form-input" placeholder="如：开福区" value="{{district}}" bindinput="onDistrictInput" />
    </view>
    <view class="form-divider"></view>

    <!-- 详细地址 -->
    <view class="form-item">
      <text class="form-label">详细地址</text>
      <input class="form-input" placeholder="请输入详细地址" value="{{detailAddress}}" bindinput="onDetailInput" />
    </view>
    <view class="form-divider"></view>

    <!-- 设为默认 -->
    <view class="form-item form-item-switch">
      <text class="form-label">设为默认</text>
      <switch class="form-switch" checked="{{isDefault}}" color="#667eea" bindchange="onDefaultChange" />
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="save-bar">
    <button class="btn-primary save-btn" bindtap="onSave">保存</button>
  </view>
</scroll-view>
