.page-container {
  padding: 0 30rpx 160rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 地址列表 */
.address-list {
  padding-top: 20rpx;
}

.address-card {
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.address-info {
  margin-bottom: 20rpx;
}

.address-name-phone {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.phone {
  font-size: 28rpx;
  color: var(--text-regular);
}

.default-tag {
  font-size: 22rpx;
  color: var(--primary-start);
  background: rgba(102, 126, 234, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.address-detail {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  display: block;
}

/* 操作按钮行 */
.address-actions {
  display: flex;
  gap: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--border-color);
}

.action-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 0;
  flex: 1;
  justify-content: center;
}

.action-icon {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.action-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.action-item:active .action-label,
.action-item:active .action-icon {
  color: var(--primary-start);
}

/* 底部新增按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--card-bg);
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.06);
}

.add-btn {
  width: 100%;
}
