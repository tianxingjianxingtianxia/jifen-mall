.page-container {
  padding: 20rpx 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-input-wrap {
  flex: 1;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 16rpx 24rpx;
  box-shadow: var(--shadow);
}

.search-input {
  font-size: 28rpx;
  color: var(--text-primary);
  width: 100%;
}

.sort-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: var(--text-regular);
  box-shadow: var(--shadow);
  white-space: nowrap;
}

.sort-arrow {
  font-size: 20rpx;
  color: var(--text-secondary);
}

/* 商品网格 */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.product-grid-item {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
}

/* 加载更多 */
.load-more {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}
.load-more-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}
