.page {
  min-height: 100vh;
  background: #f5f7fa;
}

/* 渐变头部 */
.header-bg {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 80rpx 32rpx 0;
  position: relative;
}
.header-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 100rpx;
}
.greeting-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  display: block;
}
.greeting-sub {
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 6rpx;
  display: block;
}
.header-right { position: relative; z-index: 1; }
.avatar-circle {
  width: 80rpx; height: 80rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  border: 3rpx solid rgba(255,255,255,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

/* 积分卡片 */
.points-card-wrap {
  margin: -60rpx 24rpx 0;
  position: relative;
  z-index: 2;
}
.points-card {
  background: linear-gradient(135deg, #667eea 0%, #5a67d8 100%);
  border-radius: 24rpx;
  padding: 32rpx 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(102,126,234,0.35);
}
.points-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}
.points-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.75);
  display: block;
}
.points-value {
  font-size: 64rpx;
  font-weight: 800;
  color: #fff;
  display: block;
  line-height: 1.1;
  margin-top: 4rpx;
}
.sign-btn {
  min-width: 140rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  background: rgba(255,255,255,0.2);
  border: 2rpx solid rgba(255,255,255,0.35);
  border-radius: 34rpx;
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
  padding: 0 28rpx;
}
.sign-btn.signed {
  background: rgba(72,187,120,0.3);
  border-color: rgba(72,187,120,0.5);
}
.sign-btn::after { border: none; }
.points-stats {
  display: flex;
  align-items: center;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(255,255,255,0.12);
}
.stat-item { flex: 1; text-align: center; }
.stat-num { font-size: 32rpx; font-weight: 700; display: block; }
.stat-num.earn { color: #48bb78; }
.stat-num.spend { color: #fc8181; }
.stat-lbl { font-size: 22rpx; color: rgba(255,255,255,0.6); margin-top: 4rpx; display: block; }
.stat-divider { width: 2rpx; height: 48rpx; background: rgba(255,255,255,0.12); }

/* 工具栏 */
.toolbar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  gap: 16rpx;
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.search-icon { font-size: 28rpx; margin-right: 12rpx; }
.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #303133;
  height: 60rpx;
}
.sort-btn {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 0 20rpx;
  height: 72rpx;
  font-size: 26rpx;
  color: #606266;
  gap: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.sort-arrow { font-size: 22rpx; color: #909399; }

/* 商品网格 */
.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 0 24rpx;
}
.product-item {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
  transition: transform 0.2s;
}
.product-item:active { transform: scale(0.97); }
.prod-img {
  width: 100%;
  height: 320rpx;
  background: #f0f0f0;
}
.prod-info {
  padding: 16rpx 20rpx 20rpx;
}
.prod-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #303133;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}
.prod-points {
  font-size: 28rpx;
  font-weight: 700;
  color: #e6a23c;
  display: block;
}
.prod-stock {
  font-size: 22rpx;
  color: #e6a23c;
  margin-top: 4rpx;
  display: block;
}
.prod-stock.sold-out { color: #f56c6c; }

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 24rpx 0;
}
.load-more-text {
  font-size: 24rpx;
  color: #c0c4cc;
}
