<scroll-view class="page" scroll-y bindscrolltolower="onReachBottom">

  <!-- 简单积分条 -->
  <view style="background:linear-gradient(135deg,#667eea,#764ba2);border-radius:20rpx;margin:20rpx;padding:30rpx 36rpx;">
    <view style="display:flex;align-items:center;justify-content:space-between;">
      <view>
        <text style="font-size:24rpx;color:rgba(255,255,255,0.7);display:block;">可用积分</text>
        <text style="font-size:56rpx;font-weight:800;color:#fff;display:block;margin-top:4rpx;">{{points}}</text>
      </view>
      <button style="min-width:130rpx;height:64rpx;line-height:64rpx;text-align:center;background:rgba(255,255,255,0.2);border:2rpx solid rgba(255,255,255,0.3);border-radius:32rpx;font-size:26rpx;color:#fff;padding:0 24rpx;{{todaySigned?'opacity:0.6':''}}" disabled="{{todaySigned||signing}}" bindtap="onSignIn">{{todaySigned?'已签到':'签到'}}</button>
    </view>
  </view>

  <!-- 商品网格 -->
  <view style="display:grid;grid-template-columns:1fr 1fr;gap:16rpx;padding:0 20rpx;">
    <view wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bindtap="onGoDetail" style="background:#fff;border-radius:16rpx;overflow:hidden;box-shadow:0 2rpx 8rpx rgba(0,0,0,0.06);">
      <view style="height:240rpx;background:#f0f0f0;"></view>
      <view style="padding:12rpx 16rpx 16rpx;">
        <text style="font-size:26rpx;font-weight:500;color:#303133;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">{{item.name}}</text>
        <text style="font-size:28rpx;font-weight:700;color:#e6a23c;display:block;margin-top:6rpx;">{{item.pointsRequired}} 积分</text>
      </view>
    </view>
  </view>

  <view wx:if="{{products.length === 0 && !loading}}" style="text-align:center;padding:80rpx 0;color:#c0c4cc;font-size:28rpx;">暂无商品</view>
  <view wx:if="{{loading}}" style="text-align:center;padding:40rpx;color:#909399;">加载中...</view>
  <view style="height:40rpx;"></view>
</scroll-view>
