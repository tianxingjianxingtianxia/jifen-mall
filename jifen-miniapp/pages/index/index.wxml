<scroll-view class="page" scroll-y enhanced show-scrollbar="{{false}}"
  bindscrolltolower="onReachBottom">

  <!-- 渐变头部 -->
  <view class="header-bg">
    <view class="header-content">
      <view class="greeting">
        <text class="greeting-text">Hi，{{nickname || '用户'}}</text>
        <text class="greeting-sub">欢迎回来</text>
      </view>
      <view class="header-right">
        <view class="avatar-circle" bindtap="onGoProfile">
          <text class="avatar-text">{{firstChar}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 积分卡片 -->
  <view class="points-card-wrap">
    <view class="points-card">
      <view class="points-top">
        <view class="points-left">
          <text class="points-label">可用积分</text>
          <text class="points-value">{{points}}</text>
        </view>
        <button class="sign-btn {{todaySigned ? 'signed' : ''}}"
                disabled="{{todaySigned || signing}}"
                loading="{{signing}}"
                bindtap="onSignIn">
          <text wx:if="{{!signing}}">{{todaySigned ? '已签到 ✓' : '签到'}}</text>
        </button>
      </view>
      <view class="points-stats">
        <view class="stat-item">
          <text class="stat-num earn">{{totalEarned}}</text>
          <text class="stat-lbl">累计获得</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-num spend">{{totalSpent}}</text>
          <text class="stat-lbl">累计消耗</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 搜索+排序 -->
  <view class="toolbar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索商品" value="{{keyword}}"
        bindinput="onSearchInput" bindconfirm="onSearch" confirm-type="search" />
    </view>
    <picker mode="selector" range="{{sortOptions}}" range-key="label" value="{{sortIndex}}" bindchange="onSortChange">
      <view class="sort-btn">
        <text>{{sortOptions[sortIndex].label}}</text>
        <text class="sort-arrow">▾</text>
      </view>
    </picker>
  </view>

  <!-- 商品网格 -->
  <view class="product-grid" wx:if="{{products.length > 0}}">
    <view class="product-item" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bindtap="onGoDetail">
      <image class="prod-img" src="{{item._coverImage || 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=='}}" mode="aspectFill" />
      <view class="prod-info">
        <text class="prod-name">{{item.name}}</text>
        <text class="prod-points">{{item.pointsRequired}} 积分</text>
        <text class="prod-stock" wx:if="{{item.stock < 5 && item.stock > 0}}">仅剩 {{item.stock}} 件</text>
        <text class="prod-stock sold-out" wx:if="{{item.stock < 1}}">已售罄</text>
      </view>
    </view>
  </view>

  <empty-state wx:elif="{{!loading}}" text="暂无商品" />

  <view class="load-more" wx:if="{{loading}}">
    <text class="load-more-text">加载中...</text>
  </view>
  <view class="load-more" wx:elif="{{!hasMore && products.length > 0}}">
    <text class="load-more-text">— 已经到底了 —</text>
  </view>

  <view style="height:40rpx;"></view>
</scroll-view>
